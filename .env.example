# Copy this file to .env.local, add real values, and never commit it.

# Firebase client configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin configuration.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep literal \n escapes in FIREBASE_PRIVATE_KEY.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Named Firestore database; keep this aligned with firebase.json.
FIREBASE_DATABASE_ID=prod

# Template generation.
TEMPLATE_GENERATION_API_KEY=your_template_gen_api_key
TEMPLATE_GENERATION_MODEL="gemini-3.6-flash"

# Live interview audio.
LIVE_INTERVIEW_API_KEY=your_live_interview_api_key
LIVE_INTERVIEW_MODEL="gemini-3.1-flash-live-preview"

# Feedback generation.
FEEDBACK_API_KEY=your_feedback_api_key
FEEDBACK_MODEL="gemini-3.6-flash"

# Required in every environment; generate with `openssl rand -base64 32`.
# Re-encrypt stored resumes before rotating this key.
RESUME_ENCRYPTION_KEY=your_base64_32_byte_key_from_openssl_rand

# Brandfetch client ID for logo URLs.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=your_brandfetch_client_id

# Required canonical production URL; omit the trailing slash.
APP_URL=https://your-domain.com
# Public URL for browser metadata. Keep this equal to APP_URL in production.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional logging level: debug, info, warn, or error.
LOG_LEVEL=info

# Configure a trusted client-IP header outside Vercel.
# TRUSTED_IP_HEADER=cf-connecting-ip
# TRUST_PROXY=1

# `jina` forwards submitted job URLs to Jina Reader; `direct` keeps requests local.
JOB_URL_READER_PROVIDER=direct

# Required in production for distributed rate limits.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Required in production for durable feedback processing.
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# Optional; feedback emails require both Resend values.
RESEND_API_KEY=your_resend_api_key
# Use a verified Resend sender address.
RESEND_FROM_ADDRESS="IntervoxAI <noreply@your-domain.com>"
